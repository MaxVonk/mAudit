# Database (SQLite default for zero-config local run)
DATABASE_URL="file:./dev.db"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Microsoft Entra ID Multi-Tenant App Credentials (Optional for Demo mode)
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Encryption key for session tokens (32 random bytes hex)
SESSION_SECRET="your-32-byte-hex-secret-goes-here"

